-- ======================================================================
-- MODULE LOGIC: MUSIC PLAYER
-- ======================================================================

local SoundService = game:GetService("SoundService")
local ContentProvider = game:GetService("ContentProvider")

-- 1. Khởi tạo và đồng bộ bảng toàn cục
_G.HubState = _G.HubState or {}
_G.HubLogic = _G.HubLogic or {}

-- Đồng bộ thuộc tính mặc định cho state nhạc
_G.HubState.musicID = _G.HubState.musicID or ""
_G.HubState.isMusicEnabled = _G.HubState.isMusicEnabled or false
_G.HubState.musicVolume = _G.HubState.musicVolume or 0.5

-- 2. Kiểm tra và khởi tạo đối tượng Sound duy nhất
local SOUND_NAME = "Rayfield_Music_Player"
local musicSound = SoundService:FindFirstChild(SOUND_NAME)

if not musicSound then
    musicSound = Instance.new("Sound")
    musicSound.Name = SOUND_NAME
    musicSound.Looped = true
    musicSound.Volume = _G.HubState.musicVolume
    musicSound.Parent = SoundService
end

-- Hàm hỗ trợ phát nhạc an toàn và nạp âm thanh (Preload)
local function playSoundSafely()
    if not _G.HubState.isMusicEnabled then return end
    
    local rawId = tonumber(_G.HubState.musicID)
    if rawId ~= nil and rawId > 0 then
        local soundAssetId = "rbxassetid://" .. tostring(rawId)
        
        musicSound:Stop()
        musicSound.SoundId = soundAssetId
        musicSound.Volume = _G.HubState.musicVolume or 0.5
        
        task.spawn(function()
            -- Trực tiếp phát trong pcall để Roblox tự stream âm thanh, chống crash do PreloadAsync gây Fatal Error
            if _G.HubState.isMusicEnabled and musicSound.SoundId == soundAssetId then
                local success, err = pcall(function()
                    musicSound:Play()
                end)
                if not success then
                    warn("[Music Player]: Không thể phát nhạc! Lỗi: " .. tostring(err))
                end
            end
        end)
    else
        warn("[Music Player]: ID Sound không hợp lệ!")
        _G.HubState.isMusicEnabled = false
    end
end

-- 3. Hàm xử lý Bật/Tắt Nhạc: _G.HubLogic.ToggleMusic(enabled)
_G.HubLogic.ToggleMusic = function(enabled)
    _G.HubState.isMusicEnabled = enabled

    if enabled == true then
        playSoundSafely()
    else
        -- Ngưng âm thanh ngay lập tức nếu tắt
        musicSound:Stop()
    end
end

-- 4. Hàm xử lý Cập nhật ID Nhạc: _G.HubLogic.UpdateMusicID(newIdText)
_G.HubLogic.UpdateMusicID = function(newIdText)
    _G.HubState.musicID = newIdText

    -- Nếu trình phát nhạc đang BẬT, tiến hành chuyển bài ngay lập tức
    if _G.HubState.isMusicEnabled == true then
        playSoundSafely()
    end
end

-- 5. Hàm xử lý Cập nhật Âm lượng Nhạc: _G.HubLogic.UpdateMusicVolume(vol)
_G.HubLogic.UpdateMusicVolume = function(vol)
    local volumeNum = tonumber(vol) or 0.5
    _G.HubState.musicVolume = volumeNum
    if musicSound then
        musicSound.Volume = volumeNum
    end
end
